{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Strix",
          "informationUri": "https://strix.ai",
          "rules": [
            {
              "id": "strix-coverage/technology-stack-identification",
              "name": "Technology Stack Identification",
              "shortDescription": {
                "text": "Coverage: Technology Stack Identification"
              },
              "fullDescription": {
                "text": "Coverage of Technology Stack Identification across the assessed attack surface."
              },
              "defaultConfiguration": {
                "level": "none"
              },
              "help": {
                "text": "Coverage of Technology Stack Identification across the assessed attack surface.",
                "markdown": "Coverage of Technology Stack Identification across the assessed attack surface."
              },
              "properties": {
                "tags": [
                  "coverage"
                ]
              }
            },
            {
              "id": "strix-coverage/attack-surface-mapping",
              "name": "Attack Surface Mapping",
              "shortDescription": {
                "text": "Coverage: Attack Surface Mapping"
              },
              "fullDescription": {
                "text": "Coverage of Attack Surface Mapping across the assessed attack surface."
              },
              "defaultConfiguration": {
                "level": "none"
              },
              "help": {
                "text": "Coverage of Attack Surface Mapping across the assessed attack surface.",
                "markdown": "Coverage of Attack Surface Mapping across the assessed attack surface."
              },
              "properties": {
                "tags": [
                  "coverage"
                ]
              }
            },
            {
              "id": "strix-coverage/authentication-mechanism-analysis",
              "name": "Authentication Mechanism Analysis",
              "shortDescription": {
                "text": "Coverage: Authentication Mechanism Analysis"
              },
              "fullDescription": {
                "text": "Coverage of Authentication Mechanism Analysis across the assessed attack surface."
              },
              "defaultConfiguration": {
                "level": "none"
              },
              "help": {
                "text": "Coverage of Authentication Mechanism Analysis across the assessed attack surface.",
                "markdown": "Coverage of Authentication Mechanism Analysis across the assessed attack surface."
              },
              "properties": {
                "tags": [
                  "coverage"
                ]
              }
            }
          ],
          "version": "1.7.0"
        }
      },
      "results": [
        {
          "ruleId": "strix-coverage/technology-stack-identification",
          "ruleIndex": 0,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "Technology Stack Identification — No issue identified: http://host.docker.internal:8080\n\nConfirmed target is alive and identified as OWASP Juice Shop running on nginx/1.27.5."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "http://host.docker.internal:8080"
                }
              ]
            }
          ],
          "properties": {
            "strix": {
              "coverage_outcome": "no_issue_found",
              "risk_area": "Technology Stack Identification",
              "surface": "http://host.docker.internal:8080",
              "recorded_by": "Recon Specialist",
              "source": "agent_reported"
            }
          }
        },
        {
          "ruleId": "strix-coverage/attack-surface-mapping",
          "ruleIndex": 1,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "Attack Surface Mapping — No issue identified: http://host.docker.internal:8080/routes\n\nCrawled using katana and agent-browser; identified main routes (/contact, /about, /login, /register, /jobs)."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "http://host.docker.internal:8080/routes"
                }
              ]
            }
          ],
          "properties": {
            "strix": {
              "coverage_outcome": "no_issue_found",
              "risk_area": "Attack Surface Mapping",
              "surface": "http://host.docker.internal:8080/routes",
              "recorded_by": "Recon Specialist",
              "source": "agent_reported"
            }
          }
        },
        {
          "ruleId": "strix-coverage/authentication-mechanism-analysis",
          "ruleIndex": 2,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "Authentication Mechanism Analysis — No issue identified: http://host.docker.internal:8080/auth\n\nIdentified email/password based authentication and registration flow via browser exploration."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "http://host.docker.internal:8080/auth"
                }
              ]
            }
          ],
          "properties": {
            "strix": {
              "coverage_outcome": "no_issue_found",
              "risk_area": "Authentication Mechanism Analysis",
              "surface": "http://host.docker.internal:8080/auth",
              "recorded_by": "Recon Specialist",
              "source": "agent_reported"
            }
          }
        }
      ],
      "invocations": [
        {
          "executionSuccessful": false,
          "toolExecutionNotifications": [
            {
              "level": "warning",
              "message": {
                "text": "The scan ended with status 'interrupted' rather than completing, so coverage reflects only the work finished before it stopped."
              }
            },
            {
              "level": "warning",
              "message": {
                "text": "6 agent(s) did not finish cleanly (Access Control Specialist, Auth Specialist, Business Logic Specialist, File Ops Specialist, Injection Specialist, Root Agent); any surface they held is under-covered."
              }
            },
            {
              "level": "warning",
              "message": {
                "text": "The run terminated via 'user_exit' rather than the root agent finishing, so remaining scope was not reached."
              }
            }
          ]
        }
      ]
    }
  ]
